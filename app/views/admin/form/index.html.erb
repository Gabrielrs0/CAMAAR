<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3">Resultados do Formulário</h1>
      <p class="text-muted">
        <strong>Disciplina:</strong> <%= @form.subject.class_name %><br>
        <strong>Modelo:</strong> <%= @form.template.name %>
      </p>
    </div>
    <div>
      <%= link_to 'Exportar CSV', export_csv_admin_form_path(@form), class: 'btn btn-primary' %>
    </div>
  </div>

  <% if flash[:alert] %>
    <div class="alert alert-warning">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <div class="card">
    <div class="card-header">
      Respostas Recebidas
    </div>
    <div class="card-body">
      <% if @form.answers.any? %>
        <table class="table table-striped table-hover">
          <thead>
            <tr>
              <th scope="col">Aluno</th>
              <th scope="col">Pergunta</th>
              <th scope="col">Resposta</th>
            </tr>
          </thead>
          <tbody>
            <% @form.answers.each do |answer| %>
              <tr>
                <td><%= answer.user.name %></td>
                <td><%= answer.question.content %></td>
                <td><%= answer.answer_text %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="text-center text-muted">Nenhuma resposta para este formulário ainda.</p>
      <% end %>
    </div>
  </div>

  <div class="mt-4">
    <%= link_to 'Voltar para todos os formulários', admin_forms_path, class: 'btn btn-secondary' %>
  </div>
</div>