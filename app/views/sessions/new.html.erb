<%= form_with url: login_path, scope: :session, local: true do |f| %>
    <%= f.label :identifier, "Email ou Matrícula" %>
    <%= f.text_field :identifier %>

    <%= f.label :password, "Senha" %>
    <%= f.password_field :password %>  

    <%= f.submit "Entrar" %>
<%= end %>


