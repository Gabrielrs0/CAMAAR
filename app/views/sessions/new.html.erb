
<div class="login-page">

  <div class="login-section">
    <div class="login-content">
        <% if flash[:alert] %>
            <div class="alert"><%= flash[:alert] %></div>
        <% end %>
    
        <h2>Login</h2>

        <%= form_with url: login_path, scope: :session, local: true do |f| %>
            <div class="pad-section">
            <%= f.label :identifier, "Email ou Matrícula" %>
            <%= f.text_field :identifier, placeholder: "aluno@aluno.unb.br", class: "input-field" %>
            </div>

            <div class="pad-section">
            <%= f.label :password, "Senha" %>
            <%= f.password_field :password, placeholder: "password", class: "input-field" %>
            </div>

            <%= f.submit "Entrar", class: "button" %>
        <% end %>
    </div>
  </div>

  <div class="welcome-section">
    <h1>Bem-vindo ao Camaar</h1>
  </div>

</div>

